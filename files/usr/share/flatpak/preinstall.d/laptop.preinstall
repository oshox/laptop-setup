# Flatpaks installed automatically on first boot by flatpak-preinstall.service.
# See flatpak-preinstall(1). All from the flathub remote (added by
# flatpak-add-flathub.service, which runs first).
#
# This mirrors what is flatpak-installed on the source laptop, minus the
# music taggers (puddletag, MusicBrainz Picard) which were dropped on request.

[Flatpak Preinstall com.valvesoftware.Steam]

[Flatpak Preinstall io.github.Pithos]

[Flatpak Preinstall md.obsidian.Obsidian]

[Flatpak Preinstall org.deluge_torrent.deluge]

[Flatpak Preinstall org.fedoraproject.MediaWriter]

[Flatpak Preinstall org.nicotine_plus.Nicotine]
